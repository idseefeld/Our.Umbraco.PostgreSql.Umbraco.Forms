<Project Sdk="Microsoft.NET.Sdk.Razor">

	<PropertyGroup>
		<PackageId>Our.Umbraco.PostgreSql.Umbraco.Forms</PackageId>
		<Title>Umbraco CMS - Persistence - Umbraco Forms - PostgreSQL</Title>
		<Description>Adds support for Umbraco Forms with PostgreSQL.</Description>
		<PackageTags>umbraco;umbraco-marketplace</PackageTags>
		<StaticWebAssetBasePath>\</StaticWebAssetBasePath>
		<RootNamespace>$(MSBuildProjectName.Replace(" ", "_").Replace(".pack", ""))</RootNamespace>
	</PropertyGroup>

	<ItemGroup>
		<Content Remove="UFDatasource-definition.json" />
		<None Remove="animal-prevaalues.txt" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Our.Umbraco.PostgreSql" Version="[19.0.0-rc2,19.1.0)" />
		<PackageReference Include="Our.Umbraco.PostgreSql.Umbraco.License" Version="[19.0.0-rc2,19.1.0)" />
		<PackageReference Include="Umbraco.Forms" Version="[19.0.0-beta,19.1.0)" />
		<PackageReference Include="Umbraco.Forms.Core.Providers" Version="[19.0.0-beta,19.1.0)" />
	</ItemGroup>

</Project>
